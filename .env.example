# Plaid API credentials
# Get these from https://dashboard.plaid.com/
PLAID_CLIENT_ID=your_client_id_here
PLAID_SECRET=your_secret_here

# Plaid environment: sandbox | development | production
# Use "sandbox" for development and testing
PLAID_ENV=sandbox

# Plaid Link configuration
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US

# Local database path (gitignored — contains access tokens)
DATABASE_PATH=./db/financial_advisor.db

# Flask link server port (default: 5001)
LINK_SERVER_PORT=5001
